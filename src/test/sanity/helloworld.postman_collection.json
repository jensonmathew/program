{
	"info": {
		"_postman_id": "da193b03-82f6-4c57-b953-b16991ebcfb7",
		"name": "helloworld",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "health-endpoint-inspect",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"health-endpoint-inspect\", function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.status).to.eql('UP');",
							"    pm.expect(responseJson.components.ping.status).to.eql('UP');",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{dynamic_enviroment_url}}/actuator/health",
				"description":  "Verify response of {{dynamic_enviroment_url}}/actuator/health"
			},
			"response": []
		},
		{
			"name": "info-endpoint-inspect",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"info-endpoint-inspect\", function () {",
							"    const responseJson = pm.response.json();",
							"    pm.expect(responseJson.git.commit.id.full).to.eql(pm.environment.get('ci_commit_sha'));",
							"    pm.expect(responseJson.build.name).to.eql(pm.environment.get('ci_project_name'));",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{dynamic_enviroment_url}}/actuator/info",
				"description": "Verify response of {{dynamic_enviroment_url}}/actuator/info"
			},
			"response": []
		}
	]
}
