# Default values for cdp helloworld.
# This is a YAML-formatted file.
# Declare variables to be passed into your templates.

replicaCount: 1

image:
  repository: {{CI_REGISTRY_IMAGE}}/{{CI_COMMIT_REF_SLUG}}:{{CI_COMMIT_SHA}}
  pullPolicy: Always
  
imagePullSecrets: my-reg
nameOverride: ""
fullnameOverride: ""

service:
  name: {{HELM_APP_NAME}}-service
  type: ClusterIP
  port: 80

serverName: {{SERVER_NAME}}

ingress:
  name: {{HELM_APP_NAME}}-ingress
  rules:
    host:
      serviceName: {{HELM_APP_NAME}}-service
      servicePort: 80
  tls:
    host: {{SERVER_NAME}}
  namespace: {{K8S_NS}}
  
resources:
  limits:
    cpu: "1"
    memory: 1Gi
  requests:
    cpu: 500m
    memory: 512Mi

nodeSelector: {}

tolerations: []

affinity: {}
